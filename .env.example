# Copy to .env and fill in your own values. .env is gitignored - never commit it.

# Path to the "dod" system source to serve. Defaults to the current directory,
# so running `docker compose up` from a worktree checkout (e.g.
# .worktrees/<branch>) tests that branch without touching your main checkout.
DOD_SYSTEM_PATH=.

# Path to your local, licensed Foundry VTT application install
# (the directory containing resources/app). Required - no default, since
# this is a proprietary install path specific to your machine.
FOUNDRY_APP_DIR=/absolute/path/to/foundry/app

# Directory for Foundry's user data (worlds, config, license.json). Defaults
# to ./.foundry-data if unset. Point this at a copy of an existing licensed
# data directory to skip re-entering your license key; otherwise Foundry
# will prompt for license activation on first run.
FOUNDRY_DATA_DIR=./.foundry-data

# Host port to expose Foundry on.
FOUNDRY_PORT=30002

# Docker container name.
FOUNDRY_CONTAINER_NAME=fvtt-dod-dev
