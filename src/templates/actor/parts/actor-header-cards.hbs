<div class="header-profile">
  <div class="profile-img-wrapper">
{{#if editable}}
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
{{else}}
    <img class="profile-img" src="{{actor.img}}" title="{{actor.name}}" />
{{/if}}
  </div>
  <label for="system.health" class="resource-label">{{localize 'DECK_OF_DESTINY.attributes.health.label'}}</label>
  <div class="health-inputs flex-group-center">
    <div class="health-input health-current">
      <input type="number" name="system.health.value" value="{{system.health.value}}" data-dtype="Number" min="0" />
      <label for="system.health.value" class="resource-label">{{localize 'DECK_OF_DESTINY.attributes.health.current'}}</label>
    </div>
    <div class="health-input health-max">
      <input type="number" name="system.health.max" value="{{system.health.max}}" data-dtype="Number" />
      <label for="system.health.max" class="resource-label">{{localize 'DECK_OF_DESTINY.attributes.health.max'}} </label>
    </div>
  </div>
</div>
<div class="resources grid grid-6col">
  {{#each system.cards as |card key|}}
    <div class="resource card flex-group-center">
      <img class="card-img manage-sheet-card" src="systems/dod/assets/cards/{{key}}.png" alt="{{key}} card"
        data-card-type="{{key}}">
      <label for="system.cards.{{key}}.value" class="resource-label">{{localize (lookup @root.config.cards key)}}</label>
      <div class="card-input-container">
        <input class="card-input" name="system.cards.{{key}}.value" type="number" value="{{card.value}}" min="0" />
        {{#if (ne card.modifier 0)}}
          <span class="modifier">{{#if (gt card.modifier 0)}}+{{/if}}{{card.modifier}}</span>
        {{/if}}
      </div>
    </div>
  {{/each}}
  <div class="special-cards-section">
    <button type="button" class="toggle-special-cards" data-target=".special-cards-list"
      aria-expanded="false" data-label-show="{{localize 'DECK_OF_DESTINY.labels.showSpecialCards'}}"
      data-label-hide="{{localize 'DECK_OF_DESTINY.labels.hideSpecialCards'}}">
      {{localize 'DECK_OF_DESTINY.labels.specialCards'}}
    </button>
    <div class="special-cards-list collapsed">
      {{#each specialCards as |card|}}
        <label class="special-card-row {{#unless card.available}}disabled{{/unless}}">
          <input type="checkbox" name="specialCard.{{card.suit}}"
            {{#unless card.available}}disabled{{/unless}}
            title="{{#unless card.available}}{{localize 'DECK_OF_DESTINY.messages.warnings.noSpecialCardsAvailable'}}{{/unless}}"/>
          <img class="card-img" src="{{card.img}}" alt="{{card.name}}"/>
          <span class="special-card-name">{{card.name}}</span>
        </label>
      {{else}}
        <p class="special-cards-empty">{{localize 'DECK_OF_DESTINY.dialogs.manageSpecialCards.noCards'}}</p>
      {{/each}}
    </div>
  </div>
  <div class="resource card-buttons flex-group-center">
    <button class="card-button defense-roll">
      <i class="fa-solid fa-shield-halved"></i>
      {{localize 'DECK_OF_DESTINY.actions.defense_roll'}}
    </button>
    <button class="card-button add-sheet-cards-to-pile">
      <i class="fa-solid fa-plus-square"></i>
      {{localize 'DECK_OF_DESTINY.actions.add_to_deck'}}
    </button>
    <button class="card-button draw-cards-individual" data-action="draw-cards" title="{{localize 'DECK_OF_DESTINY.messages.DrawRound.ButtonTooltip'}}">
      <i class="fa-solid fa-cards"></i>
      {{localize 'DECK_OF_DESTINY.messages.DrawRound.Button'}}
    </button>
    <button class="card-button reset-sheet-cards">
      <i class="fa-solid fa-rotate-right"></i>
      {{localize 'DECK_OF_DESTINY.actions.reset'}}
    </button>
  </div>
</div>
